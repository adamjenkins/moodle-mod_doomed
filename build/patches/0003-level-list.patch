diff --git a/src/doom/doomed_levels.c b/src/doom/doomed_levels.c
new file mode 100644
index 00000000..27a45414
--- /dev/null
+++ b/src/doom/doomed_levels.c
@@ -0,0 +1,238 @@
+//
+// Copyright(C) 2026 Adam Jenkins
+//
+// This program is free software; you can redistribute it and/or
+// modify it under the terms of the GNU General Public License
+// as published by the Free Software Foundation; either version 2
+// of the License, or (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// DESCRIPTION:
+//  Level list for Moodle mod_doomed. See doomed_levels.h.
+//
+
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+
+#include "doomdef.h"
+#include "doomstat.h"
+#include "d_main.h"
+#include "m_argv.h"
+#include "m_misc.h"
+
+#include "doomed_bridge.h"
+#include "doomed_levels.h"
+
+#define MAX_LEVELS 32
+
+typedef enum
+{
+    ROUTE_NONE,     // normal game behaviour
+    ROUTE_NEXT,     // go to route_episode/route_map after the intermission
+    ROUTE_FINISH,   // the list is done: end the game after the intermission
+    ROUTE_VICTORY   // freeplay past a listed ExM8: the episode's normal ending
+} route_t;
+
+static char levels[MAX_LEVELS][9];
+static int numlevels = -1;
+static boolean freeplay;
+
+static route_t route = ROUTE_NONE;
+static int route_episode;
+static int route_map;
+
+// Parse ExMy or MAPxx. Returns false for anything else.
+static boolean ParseMapName(const char *name, int *episode, int *map)
+{
+    int e, m;
+    char tail;
+
+    if (sscanf(name, "E%1dM%1d%c", &e, &m, &tail) == 2 && e >= 1 && m >= 1)
+    {
+        *episode = e;
+        *map = m;
+        return true;
+    }
+    if (sscanf(name, "MAP%2d%c", &m, &tail) == 1 && m >= 1 && strlen(name) == 5)
+    {
+        *episode = 1;
+        *map = m;
+        return true;
+    }
+    return false;
+}
+
+static void MapName(int episode, int map, char *buf, size_t len)
+{
+    if (gamemode == commercial)
+    {
+        M_snprintf(buf, len, "MAP%02d", map);
+    }
+    else
+    {
+        M_snprintf(buf, len, "E%dM%d", episode, map);
+    }
+}
+
+static void LoadLevels(void)
+{
+    char list[MAX_LEVELS * 9 + 1];
+    char *token;
+    int p;
+
+    if (numlevels >= 0)
+    {
+        return;
+    }
+    numlevels = 0;
+    freeplay = M_ParmExists("-doomedfreeplay");
+
+    p = M_CheckParmWithArgs("-doomedlevels", 1);
+    if (!p)
+    {
+        return;
+    }
+    M_StringCopy(list, myargv[p + 1], sizeof(list));
+    for (token = strtok(list, ","); token != NULL && numlevels < MAX_LEVELS;
+         token = strtok(NULL, ","))
+    {
+        int e, m;
+        char *c;
+
+        for (c = token; *c != '\0'; ++c)
+        {
+            *c = toupper((unsigned char) *c);
+        }
+        if (strlen(token) < sizeof(levels[0]) && ParseMapName(token, &e, &m))
+        {
+            M_StringCopy(levels[numlevels], token, sizeof(levels[0]));
+            ++numlevels;
+        }
+    }
+}
+
+static int LevelIndex(int episode, int map)
+{
+    char name[16];
+    int i;
+
+    LoadLevels();
+    MapName(episode, map, name, sizeof(name));
+    for (i = 0; i < numlevels; ++i)
+    {
+        if (!strcmp(levels[i], name))
+        {
+            return i;
+        }
+    }
+    return -1;
+}
+
+boolean DOOMED_LevelListActive(void)
+{
+    LoadLevels();
+    return numlevels > 0;
+}
+
+boolean DOOMED_MapAllowed(int episode, int map)
+{
+    return !DOOMED_LevelListActive() || freeplay || LevelIndex(episode, map) >= 0;
+}
+
+boolean DOOMED_CurrentMapListed(void)
+{
+    return DOOMED_LevelListActive() && LevelIndex(gameepisode, gamemap) >= 0;
+}
+
+void DOOMED_FilterNewGame(int *episode, int *map)
+{
+    int e, m;
+
+    if (DOOMED_MapAllowed(*episode, *map))
+    {
+        return;
+    }
+    if (ParseMapName(levels[0], &e, &m))
+    {
+        *episode = e;
+        *map = m;
+    }
+}
+
+void DOOMED_PlanRoute(wbstartstruct_t *wbs)
+{
+    int index;
+    int e, m;
+
+    route = ROUTE_NONE;
+    if (!DOOMED_LevelListActive() || demoplayback)
+    {
+        return;
+    }
+    index = LevelIndex(gameepisode, gamemap);
+    if (index >= 0 && index < numlevels - 1
+        && ParseMapName(levels[index + 1], &e, &m))
+    {
+        route = ROUTE_NEXT;
+        route_episode = gamemode == commercial ? gameepisode : e;
+        route_map = m;
+        // The intermission names the next level; it can only show one in
+        // the same episode.
+        if (route_episode == gameepisode)
+        {
+            wbs->next = m - 1;
+        }
+    }
+    else if (!freeplay)
+    {
+        route = ROUTE_FINISH;
+    }
+    else if (index >= 0 && gamemode != commercial && gamemap == 8)
+    {
+        // G_DoCompleted skipped the victory to show this listed map's
+        // intermission; restore the episode ending afterwards.
+        route = ROUTE_VICTORY;
+    }
+}
+
+boolean DOOMED_WorldDone(void)
+{
+    switch (route)
+    {
+        case ROUTE_NEXT:
+        case ROUTE_FINISH:
+            // Skip the between-episode text screens: straight on.
+            gameaction = ga_worlddone;
+            return true;
+        case ROUTE_VICTORY:
+            route = ROUTE_NONE;
+            gameaction = ga_victory;
+            return true;
+        default:
+            return false;
+    }
+}
+
+boolean DOOMED_DoWorldDone(void)
+{
+    switch (route)
+    {
+        case ROUTE_NEXT:
+            route = ROUTE_NONE;
+            gameepisode = route_episode;
+            wminfo.next = route_map - 1;
+            return false;
+        case ROUTE_FINISH:
+            route = ROUTE_NONE;
+            DOOMED_GameFinished();
+            D_StartTitle();
+            return true;
+        default:
+            return false;
+    }
+}
