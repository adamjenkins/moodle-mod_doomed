diff --git a/src/doom/doomed_bridge.c b/src/doom/doomed_bridge.c
new file mode 100644
index 00000000..0b760f4f
--- /dev/null
+++ b/src/doom/doomed_bridge.c
@@ -0,0 +1,152 @@
+//
+// Copyright(C) 2026 Adam Jenkins
+//
+// This program is free software; you can redistribute it and/or
+// modify it under the terms of the GNU General Public License
+// as published by the Free Software Foundation; either version 2
+// of the License, or (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// DESCRIPTION:
+//  Bridge from the engine to the embedding web page (Moodle mod_doomed).
+//
+//  Each event is serialised to a small JSON object and handed to
+//  Module.onDoomedEvent(event) if the page defined it. The page is
+//  responsible for anything further (logging, grading, syncing saves).
+//
+
+#include <stdio.h>
+
+#include "doomdef.h"
+#include "doomstat.h"
+#include "i_timer.h"
+#include "m_misc.h"
+
+#include "doomed_bridge.h"
+
+#ifdef __EMSCRIPTEN__
+
+#include <emscripten.h>
+
+EM_JS(void, doomed_post_json, (const char *json), {
+    var text = UTF8ToString(json);
+    if (typeof Module['onDoomedEvent'] === 'function') {
+        try {
+            Module['onDoomedEvent'](JSON.parse(text));
+        } catch (e) {
+            console.error('mod_doomed: bridge handler failed', e);
+        }
+    }
+});
+
+// Map lump name of the current level: MAPxx or ExMy.
+static void CurrentMapName(char *buf, size_t len)
+{
+    if (gamemode == commercial)
+    {
+        M_snprintf(buf, len, "MAP%02d", gamemap);
+    }
+    else
+    {
+        M_snprintf(buf, len, "E%dM%d", gameepisode, gamemap);
+    }
+}
+
+// Common prefix: event type, map and skill (1-5, as shown in the menu).
+static void Post(const char *type, const char *extra)
+{
+    char map[16];
+    char json[512];
+
+    CurrentMapName(map, sizeof(map));
+    M_snprintf(json, sizeof(json),
+               "{\"type\":\"%s\",\"map\":\"%s\",\"skill\":%d%s%s}",
+               type, map, (int) gameskill + 1,
+               extra[0] != '\0' ? "," : "", extra);
+    doomed_post_json(json);
+}
+
+void DOOMED_GameStart(void)
+{
+    if (demoplayback)
+    {
+        return;
+    }
+    Post("gamestart", "");
+}
+
+void DOOMED_LevelStart(void)
+{
+    char extra[128];
+
+    if (demoplayback)
+    {
+        return;
+    }
+    M_snprintf(extra, sizeof(extra),
+               "\"totalkills\":%d,\"totalitems\":%d,\"totalsecrets\":%d",
+               totalkills, totalitems, totalsecret);
+    Post("levelstart", extra);
+}
+
+void DOOMED_LevelComplete(wbstartstruct_t *wbs)
+{
+    char extra[384];
+    const wbplayerstruct_t *me;
+
+    if (demoplayback || wbs == NULL)
+    {
+        return;
+    }
+    me = &wbs->plyr[wbs->pnum];
+    M_snprintf(extra, sizeof(extra),
+               "\"kills\":%d,\"totalkills\":%d,"
+               "\"items\":%d,\"totalitems\":%d,"
+               "\"secrets\":%d,\"totalsecrets\":%d,"
+               "\"timetics\":%d,\"partics\":%d,\"ticrate\":%d,"
+               "\"secretexit\":%s",
+               me->skills, wbs->maxkills,
+               me->sitems, wbs->maxitems,
+               me->ssecret, wbs->maxsecret,
+               me->stime, wbs->partime, TICRATE,
+               wbs->didsecret ? "true" : "false");
+    Post("levelcomplete", extra);
+}
+
+void DOOMED_PlayerDeath(mobj_t *target)
+{
+    char extra[192];
+    player_t *player;
+
+    if (demoplayback || target == NULL || target->player == NULL
+        || target->player != &players[consoleplayer])
+    {
+        return;
+    }
+    player = target->player;
+    M_snprintf(extra, sizeof(extra),
+               "\"kills\":%d,\"items\":%d,\"secrets\":%d,\"timetics\":%d,"
+               "\"ticrate\":%d",
+               player->killcount, player->itemcount, player->secretcount,
+               leveltime, TICRATE);
+    Post("death", extra);
+}
+
+void DOOMED_GameSaved(void)
+{
+    Post("saved", "");
+}
+
+#else
+
+void DOOMED_GameStart(void) {}
+void DOOMED_LevelStart(void) {}
+void DOOMED_LevelComplete(wbstartstruct_t *wbs) { (void) wbs; }
+void DOOMED_PlayerDeath(mobj_t *target) { (void) target; }
+void DOOMED_GameSaved(void) {}
+
+#endif
