+void DOOMED_GameStart(void);
+void DOOMED_LevelStart(void);
+void DOOMED_LevelComplete(wbstartstruct_t *wbs);
+void DOOMED_PlayerDeath(mobj_t *target);
+void DOOMED_GameSaved(void);
+
+#endif
